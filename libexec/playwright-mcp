#!/usr/bin/env bash
# Playwright MCP server (stdio). nixpkgs ships it with matching browsers;
# elsewhere the npm package is pinned.
set -euo pipefail
PIN=0.0.83

if command -v nix >/dev/null 2>&1; then
  exec nix run nixpkgs#playwright-mcp -- "$@"
elif command -v npx >/dev/null 2>&1; then
  exec npx -y "@playwright/mcp@$PIN" "$@"
fi
echo "playwright-mcp: needs nix or node (npx)" >&2
exit 127
